---
import { useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const paragraphs = [t('about.p1'), t('about.p2'), t('about.p3'), t('about.p4')];

const stats = [
  { value: t('about.stat1.value'), label: t('about.stat1.label') },
  { value: t('about.stat2.value'), label: t('about.stat2.label') },
  { value: t('about.stat3.value'), label: t('about.stat3.label') },
];
---

<section id="about" class="bg-cream-100">
  <div class="mx-auto grid max-w-6xl gap-14 px-5 py-24 lg:grid-cols-[1.3fr_1fr] lg:gap-16 lg:px-8">
    <div data-reveal>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-600">
        {t('about.eyebrow')}
      </p>
      <h2 class="mt-4 font-display text-4xl font-medium leading-tight text-ink-800 sm:text-5xl">
        {t('about.title')}
      </h2>

      <div class="mt-8 space-y-5 text-[1.05rem] leading-relaxed text-ink-800/80">
        {paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-5">
      {stats.map((stat, i) => (
        <div
          data-reveal
          style={`animation-delay: ${120 + i * 110}ms`}
          class="rounded-2xl border border-ink-800/10 bg-cream-50 px-8 py-7 shadow-sm transition-shadow duration-300 hover:shadow-md"
        >
          <p class="font-display text-4xl font-medium text-brand-600">{stat.value}</p>
          <p class="mt-1 text-sm text-ink-800/70">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
