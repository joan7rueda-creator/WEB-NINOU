---
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '@/i18n/utils';
import { SITE } from '@/data/site';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import liveShot from '@/assets/gallery/gallery-05.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden bg-ink-800 text-cream-50">
  <div
    class="pointer-events-none absolute inset-0 opacity-30"
    style="background:radial-gradient(circle at 12% 88%, theme(colors.brand.700) 0%, transparent 45%), radial-gradient(circle at 92% 8%, #833ab4 0%, transparent 40%);"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-5 py-24 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-28">
    <div data-reveal>
      <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.2em] text-brand-400">
        <Icon name="instagram" class="h-4 w-4" />
        {t('instagram.eyebrow')}
      </p>
      <h2 class="mt-5 font-display text-4xl font-medium uppercase leading-tight tracking-wide sm:text-5xl">
        {t('instagram.title')}
      </h2>
      <p class="mt-6 max-w-md text-lg text-cream-100/80">
        {t('instagram.subtitle')}
      </p>

      <div class="mt-9">
        <Button href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" variant="primary">
          <Icon name="instagram" class="h-4 w-4" />
          {t('instagram.cta')}
        </Button>
      </div>
    </div>

    <div data-reveal style="animation-delay: 120ms" class="relative mx-auto w-full max-w-sm">
      <!-- Anillo degradado inspirado en el lenguaje visual de Instagram (naranja-rosa-violeta),
           como acento decorativo — no reproduce la interfaz real de la app. -->
      <div class="absolute -inset-[3px] rounded-[2.25rem] bg-[conic-gradient(from_180deg,#feda75,#fa7e1e,#d62976,#962fbf,#4f5bd5,#feda75)]"></div>

      <div class="relative aspect-square overflow-hidden rounded-[2.25rem] border-[6px] border-ink-800">
        <Image
          src={liveShot}
          alt={t('instagram.imageAlt')}
          width={640}
          height={640}
          class="h-full w-full object-cover object-[50%_28%]"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-900/80 via-ink-900/0 to-ink-900/10"></div>

        <span class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-red-600 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white shadow-lg shadow-ink-900/30">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-white"></span>
          </span>
          {t('instagram.live')}
        </span>

        <span class="absolute inset-x-4 bottom-4 flex items-center gap-2 text-sm font-medium text-cream-50">
          <Icon name="instagram" class="h-4 w-4 shrink-0" />
          {SITE.social.instagramHandle}
        </span>
      </div>
    </div>
  </div>
</section>
