---
import { useTranslations, type Lang } from '@/i18n/utils';
import { PRODUCT_CATEGORIES, getCategoryPath } from '@/data/products';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="products" class="bg-cream-50">
  <div class="mx-auto max-w-6xl px-5 py-24 lg:px-8">
    <div data-reveal class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-600">
        {t('products.eyebrow')}
      </p>
      <h2 class="mt-4 font-display text-4xl font-medium text-ink-800 sm:text-5xl">
        {t('products.title')}
      </h2>
      <p class="mt-4 text-lg text-ink-800/70">{t('products.subtitle')}</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {PRODUCT_CATEGORIES.map((cat, i) => (
        <a
          href={getCategoryPath(lang, cat.id)}
          data-reveal
          style={`animation-delay: ${i * 90}ms`}
          class="group block"
        >
          <!--
            Marcador de posición mientras no tenemos fotografía real de cada categoría.
            Sustituir por <Image src={...} alt="…" /> en cuanto lleguen las fotos.
          -->
          <div class={`aspect-[4/5] overflow-hidden rounded-2xl bg-gradient-to-br ${cat.gradient} shadow-sm transition-transform duration-500 ease-out group-hover:scale-[1.03]`}></div>
          <h3 class="mt-4 flex items-center gap-1.5 font-display text-xl font-medium text-ink-800 group-hover:text-brand-600">
            {t(cat.nameKey)}
            <Icon name="chevron-right" class="h-4 w-4 shrink-0 opacity-0 transition-opacity group-hover:opacity-100" />
          </h3>
          <p class="mt-1 text-sm text-ink-800/65">{t(cat.descKey)}</p>
        </a>
      ))}
    </div>

    <div data-reveal class="mt-14">
      <Button href="#store-info" variant="primary">
        {t('products.cta')}
        <Icon name="chevron-right" class="h-4 w-4" />
      </Button>
    </div>
  </div>
</section>
