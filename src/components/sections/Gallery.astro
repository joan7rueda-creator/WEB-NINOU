---
import { Image } from 'astro:assets';
import { useTranslations, type UIKey, type Lang } from '@/i18n/utils';

import g1 from '@/assets/gallery/gallery-01.jpg';
import g2 from '@/assets/gallery/gallery-02.jpg';
import g3 from '@/assets/gallery/gallery-03.jpg';
import g4 from '@/assets/gallery/gallery-04.jpg';
import g5 from '@/assets/gallery/gallery-05.jpg';
import g6 from '@/assets/gallery/gallery-06.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const photos: { src: typeof g1; altKey: UIKey }[] = [
  { src: g1, altKey: 'gallery.alt.1' },
  { src: g2, altKey: 'gallery.alt.2' },
  { src: g3, altKey: 'gallery.alt.3' },
  { src: g4, altKey: 'gallery.alt.4' },
  { src: g5, altKey: 'gallery.alt.5' },
  { src: g6, altKey: 'gallery.alt.6' },
];
---

<section id="gallery" class="bg-cream-100">
  <div class="mx-auto max-w-6xl px-5 py-24 lg:px-8">
    <div data-reveal class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-600">
        {t('gallery.eyebrow')}
      </p>
      <h2 class="mt-4 font-display text-4xl font-medium text-ink-800 sm:text-5xl">
        {t('gallery.title')}
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-3">
      {photos.map((photo, i) => (
        <a
          href={photo.src.src}
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
          style={`animation-delay: ${(i % 3) * 90}ms`}
          class="group block overflow-hidden rounded-2xl"
        >
          <Image
            src={photo.src}
            alt={t(photo.altKey)}
            width={600}
            height={750}
            class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            loading={i < 3 ? 'eager' : 'lazy'}
          />
        </a>
      ))}
    </div>
  </div>
</section>
