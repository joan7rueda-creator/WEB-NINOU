---
import { SITE } from '@/data/site';
import { useTranslations, type Lang } from '@/i18n/utils';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="location" class="bg-cream-100">
  <div class="mx-auto max-w-6xl px-5 py-24 lg:px-8">
    <div data-reveal class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-600">
        {t('location.eyebrow')}
      </p>
      <h2 class="mt-4 font-display text-4xl font-medium text-ink-800 sm:text-5xl">
        {t('location.title')}
      </h2>
      <p class="mt-4 flex items-center gap-2 text-lg text-ink-800/70">
        <Icon name="map-pin" class="h-5 w-5 shrink-0 text-brand-600" />
        {SITE.address.street}, {SITE.address.postalCode} {SITE.address.city}
      </p>
      <Button href={SITE.maps.directionsUrl} target="_blank" rel="noopener noreferrer" variant="primary" class="mt-7">
        {t('location.cta')}
        <Icon name="chevron-right" class="h-4 w-4" />
      </Button>
    </div>

    <div data-reveal style="animation-delay: 120ms" class="mt-12 overflow-hidden rounded-3xl border border-ink-800/10 shadow-sm">
      <iframe
        src={SITE.maps.embedUrl}
        title={`Mapa: ${SITE.name}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="h-[420px] w-full grayscale-[15%]"
      ></iframe>
    </div>
  </div>
</section>
