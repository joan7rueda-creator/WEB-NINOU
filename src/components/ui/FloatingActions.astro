---
import { SITE } from '@/data/site';
import { useTranslations, type Lang } from '@/i18n/utils';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="fixed bottom-5 right-5 z-50 flex flex-col items-end gap-3">
  <a
    href={`tel:${SITE.contact.phone}`}
    aria-label={t('cta.call')}
    class="flex h-14 w-14 items-center justify-center rounded-full bg-ink-800 text-cream-50 shadow-lg shadow-ink-900/25 transition-transform hover:-translate-y-0.5 hover:bg-ink-700"
  >
    <Icon name="phone" class="h-6 w-6" />
  </a>
  <a
    href={SITE.whatsappUrl(t('cta.whatsapp.message'))}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t('cta.whatsapp')}
    class="flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-ink-900/25 transition-transform hover:-translate-y-0.5 hover:brightness-105"
  >
    <Icon name="whatsapp" class="h-7 w-7" />
  </a>
</div>
