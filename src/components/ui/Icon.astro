---
interface Props {
  name:
    | 'phone'
    | 'whatsapp'
    | 'mail'
    | 'map-pin'
    | 'clock'
    | 'instagram'
    | 'menu'
    | 'close'
    | 'chevron-right'
    | 'quote'
    | 'star';
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
---

{
  name === 'phone' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M5 4h3.2l1.6 4.5-2 1.6a11.5 11.5 0 0 0 5.1 5.1l1.6-2 4.5 1.6V18a2 2 0 0 1-2 2A15 15 0 0 1 3 5a2 2 0 0 1 2-2Z" />
    </svg>
  )
}
{
  name === 'whatsapp' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M7 17.5 4.5 20l.9-3.4A8 8 0 1 1 8.8 19L7 17.5Z" />
      <path d="M8.7 9.3c0 3.2 2.8 6 6 6 .5 0 .9-.5.7-1l-.8-1.6c-.2-.3-.6-.4-.9-.3l-1 .4a5 5 0 0 1-2.5-2.5l.4-1c.1-.3 0-.7-.3-.9L8.7 7.6c-.5-.2-1 .2-1 .7v1Z" />
    </svg>
  )
}
{
  name === 'mail' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <rect x="3.5" y="5.5" width="17" height="13" rx="2" />
      <path d="m4.5 7 7.5 6 7.5-6" />
    </svg>
  )
}
{
  name === 'map-pin' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M12 21.5S19 15.4 19 10a7 7 0 1 0-14 0c0 5.4 7 11.5 7 11.5Z" />
      <circle cx="12" cy="10" r="2.5" />
    </svg>
  )
}
{
  name === 'clock' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <circle cx="12" cy="12" r="8.25" />
      <path d="M12 7.5V12l3 2" />
    </svg>
  )
}
{
  name === 'instagram' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="16.8" cy="7.2" r="0.6" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === 'menu' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class={className} aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  )
}
{
  name === 'close' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class={className} aria-hidden="true">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  )
}
{
  name === 'chevron-right' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="m9 6 6 6-6 6" />
    </svg>
  )
}
{
  name === 'quote' && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <path d="M9.5 6C6.5 7.3 5 9.6 5 12.8v4.7h5.5v-5.5H7.8c.2-2 1.3-3.2 2.9-3.9L9.5 6Zm9 0c-3 1.3-4.5 3.6-4.5 6.8v4.7H19v-5.5h-2.7c.2-2 1.3-3.2 2.9-3.9L18.5 6Z" />
    </svg>
  )
}
{
  name === 'star' && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <path d="m12 3 2.7 5.9 6.3.7-4.7 4.4 1.3 6.3L12 17.4 6.4 20.3l1.3-6.3-4.7-4.4 6.3-.7L12 3Z" />
    </svg>
  )
}
