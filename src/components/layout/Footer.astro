---
import { SITE } from '@/data/site';
import { useTranslations, type Lang } from '@/i18n/utils';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-800/10 bg-ink-800 text-cream-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-4 lg:px-8">
    <div class="sm:col-span-2 lg:col-span-1">
      <p class="font-display text-xl font-semibold text-cream-50">
        Ninou <span class="text-brand-400">Marroquineria</span>
      </p>
      <p class="mt-3 max-w-xs text-sm text-cream-100/70">{t('site.tagline')}</p>
      <a
        href={SITE.social.instagram}
        target="_blank"
        rel="noopener noreferrer me"
        class="mt-5 inline-flex items-center gap-2 rounded-full border border-cream-50/15 px-4 py-2 text-sm font-medium transition-colors hover:border-brand-400 hover:text-brand-400"
      >
        <Icon name="instagram" class="h-4 w-4" />
        {SITE.social.instagramHandle}
      </a>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-cream-50/90">
        {t('storeInfo.title')}
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm text-cream-100/70">
        <li>{SITE.address.street}</li>
        <li>{SITE.address.postalCode} {SITE.address.city}</li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-cream-50/90">
        {t('nav.contact')}
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm text-cream-100/70">
        <li>
          <a href={`tel:${SITE.contact.phone}`} class="hover:text-brand-400">{SITE.contact.phoneDisplay}</a>
        </li>
        <li>
          <a href={`mailto:${SITE.contact.email}`} class="hover:text-brand-400 break-all">{SITE.contact.email}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-cream-50/90">
        {t('nav.home')}
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm text-cream-100/70">
        <li><a href="#about" class="hover:text-brand-400">{t('nav.about')}</a></li>
        <li><a href="#gallery" class="hover:text-brand-400">{t('nav.gallery')}</a></li>
        <li><a href="#location" class="hover:text-brand-400">{t('nav.location')}</a></li>
        <li><a href="#contact" class="hover:text-brand-400">{t('nav.contact')}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-cream-50/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-6 text-xs text-cream-100/50 sm:flex-row sm:items-center sm:justify-between lg:px-8">
      <p>&copy; {year} {SITE.name}. {t('footer.legal.rights')}</p>
      <p>{t('footer.legal.madeWith')}</p>
    </div>
  </div>
</footer>
