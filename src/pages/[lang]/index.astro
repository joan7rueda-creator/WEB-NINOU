---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import FloatingActions from '@/components/ui/FloatingActions.astro';
import Hero from '@/components/sections/Hero.astro';
import About from '@/components/sections/About.astro';
import Products from '@/components/sections/Products.astro';
import Brands from '@/components/sections/Brands.astro';
import InstagramLive from '@/components/sections/InstagramLive.astro';
import Gallery from '@/components/sections/Gallery.astro';
import StoreInfo from '@/components/sections/StoreInfo.astro';
import Contact from '@/components/sections/Contact.astro';
import { useTranslations, type Lang } from '@/i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'ca' } }, { params: { lang: 'es' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout lang={lang} path="/" title={`${lang === 'ca' ? 'Ninou Marroquineria' : 'Ninou Marroquinería'} — ${t('site.tagline')}`} description={t('site.description')}>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <About lang={lang} />
    <Products lang={lang} />
    <Brands lang={lang} />
    <InstagramLive lang={lang} />
    <Gallery lang={lang} />
    <StoreInfo lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <FloatingActions lang={lang} />
</BaseLayout>
